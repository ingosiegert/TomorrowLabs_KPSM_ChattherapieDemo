rules = []

def add(keyword, rank, patterns=None, responses=None, tags=None):
    rules.append({
        "id": f"de_eliza_{len(rules)+1:03d}",
        "keyword": keyword,
        "rank": rank,
        "patterns": patterns or [],
        "responses": responses or [],
        "tags": tags or []
    })


def unique_in_order(items):
    seen = set()
    result = []
    for item in items:
        if item in seen:
            continue
        seen.add(item)
        result.append(item)
    return result



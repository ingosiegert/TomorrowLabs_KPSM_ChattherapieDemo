def enrich_rules_for_variety(rule_list):
    for rule in rule_list:
        responses = [response for response in rule.get("responses", []) if isinstance(response, str) and response.strip()]
        responses = unique_in_order(responses)
        tags = [str(tag).lower() for tag in rule.get("tags", [])]
        pool = []
        for tag in tags:
            pool.extend(VARIATION_BY_TAG.get(tag, []))
        if not pool:
            pool = list(VARIATION_BY_TAG["default"])
        if not pool:
            rule["responses"] = responses
            continue
        start = sum(ord(ch) for ch in str(rule.get("keyword", ""))) % len(pool)
        extras = [pool[(start + offset) % len(pool)] for offset in range(min(3, len(pool)))]
        rule["responses"] = unique_in_order(responses + extras)


def enrich_patterns_for_coverage(rule_list):
    for rule in rule_list:
        patterns = [pattern for pattern in rule.get("patterns", []) if isinstance(pattern, str) and pattern.strip()]
        expanded = []
        for raw in patterns:
            normalized = " ".join(raw.strip().split())
            expanded.append(normalized)
            if normalized.startswith("* ") and normalized.endswith(" *"):
                core = normalized[2:-2].strip()
                if core:
                    expanded.extend([f"* {core}", f"{core} *", core])
            elif normalized.startswith("* "):
                core = normalized[2:].strip()
                if core:
                    expanded.append(core)
            elif normalized.endswith(" *"):
                core = normalized[:-2].strip()
                if core:
                    expanded.append(core)
        rule["patterns"] = unique_in_order(expanded) if expanded else ["*"]

